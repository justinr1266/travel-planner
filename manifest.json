{
  "manifest_version": 3,
  "name": "RouteWise — Travel Scenario Planner",
  "version": "0.4.10",
  "description": "Trip scenarios with user-reviewed flight imports and multimodal comparisons.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/travel/flights*"
      ],
      "js": [
        "flights-overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.omio.com/*",
        "https://omio.com/*",
        "https://www.thetrainline.com/*",
        "https://thetrainline.com/*"
      ],
      "js": [
        "train-results.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open RouteWise"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
