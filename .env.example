# Get a free Groq API key at https://console.groq.com/keys
# Never paste it into extension JavaScript, GitHub, or chat.
GROQ_API_KEY=replace-with-your-groq-key
# GPT-OSS 20B supports strict structured JSON output in GroqCloud.
GROQ_MODEL=openai/gpt-oss-20b
PORT=8787
# Optional: set to the 32-character Chrome extension ID from chrome://extensions
ROUTEWISE_EXTENSION_ID=
